# ---------- python ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# ---------- node / frontend ----------
frontend/node_modules/
frontend/dist/
frontend/.vite/
