# --- copy to .env and fill in ---
# LLM (OpenAI)
LLM_PROVIDER=openai            # openai | fake
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# Voice (ElevenLabs)
VOICE_PROVIDER=elevenlabs      # elevenlabs | fake
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# AI Lab (isolated module: prompt → keyframe images → animated 9:16 video)
GOOGLE_API_KEY=...
GOOGLE_VIDEO_MODEL=veo-3.1-fast-generate-preview   # video-capable models on Gemini API: veo-3.1-generate-preview | veo-3.1-fast-generate-preview | veo-3.1-lite-generate-preview
OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_SIZE=1024x1536      # generated portrait size, cropped to 9:16 → 1080x1920
# LAB_PLANNER=openai               # openai | fake
# LAB_IMAGE_PROVIDER=openai        # openai | fake
# LAB_VIDEO_PROVIDER=google        # google | fake

# Optional
# DEFAULT_PERSONA=michael          # configs/personas/<id>.json
# LOG_LEVEL=INFO
# RENDER_THREADS=0
