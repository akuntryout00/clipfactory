# ClipFactory — copy to .env and fill in the keys you have (see README for which feature needs which key)
# LLM (OpenAI)
LLM_PROVIDER=openai            # openai | fake
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# Voice (ElevenLabs)
VOICE_PROVIDER=elevenlabs      # elevenlabs | fake
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# AI Lab (isolated module: prompt → keyframe images → animated 9:16 video)
GOOGLE_API_KEY=...
GOOGLE_VIDEO_MODEL=gemini-omni-flash-preview
FAL_KEY=...                       # fal.ai → Dashboard → Keys (enables fal:minimax-h3, fal:seedance-2.0, fal:seedance-2.0-fast, fal:kling-3.0-std)
# LAB_FAL_MODEL=minimax-h3         # default model when provider is plain 'fal'
# LAB_VIDEO_PROVIDER=omni           # default provider for new videos: omni | veo | fal | fal:<model> | fake (each video can pick its own)
# GOOGLE_VEO_MODEL=veo-3.1-fast-generate-preview
OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_SIZE=1024x1536      # generated portrait size, cropped to 9:16 → 1080x1920
# OPENAI_IMAGE_QUALITY=low         # low | medium | high (low ≈ 20 s, medium ≈ 40 s, high ≈ 100 s per image)
# OPENAI_IMAGE_INPUT_FIDELITY=high # how closely each keyframe follows the previous one (edit endpoint)
# LAB_PLANNER=openai               # openai | fake
# LAB_IMAGE_PROVIDER=openai        # openai | fake
# LAB_VIDEO_PROVIDER=google        # google | fake

# Optional
# DEFAULT_PERSONA=michael          # configs/personas/<id>.json
# LOG_LEVEL=INFO
# RENDER_THREADS=0
