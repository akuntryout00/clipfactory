# --- copy to .env and fill in ---
# LLM (OpenAI)
LLM_PROVIDER=openai            # openai | fake
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# Voice (ElevenLabs)
VOICE_PROVIDER=elevenlabs      # elevenlabs | fake
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# Optional
# LOG_LEVEL=INFO
# RENDER_THREADS=0
