# ClipFactory — copy to .env and fill in the keys you have (see README for which feature needs which key).
# Everything runs locally; keys are only used to call the providers you configure. Never commit .env.

# ---------- content factory: LLM (scripts, scene plans, B-roll tagging, personas, topics) ----------
LLM_PROVIDER=openai               # openai | fake (fake = offline, deterministic; used by tests)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1              # any chat.completions model with structured outputs

# ---------- content factory: voice ----------
VOICE_PROVIDER=elevenlabs         # elevenlabs | fake
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...           # default voice; a persona can set its own voice_id

# ---------- AI Lab (separate module: prompt → keyframes → animated 9:16 video) ----------
GOOGLE_API_KEY=...                # Gemini Omni / Veo (optional)
GOOGLE_VIDEO_MODEL=gemini-omni-flash-preview
# GOOGLE_VEO_MODEL=veo-3.1-fast-generate-preview
# GOOGLE_PERSON_GENERATION=allow_adult
FAL_KEY=...                       # fal.ai → Dashboard → Keys (optional; enables MiniMax H3, Seedance 2.0/2.5, Kling 3.0)
# LAB_FAL_MODEL=minimax-h3        # default model when the provider is plain 'fal'
# LAB_VIDEO_PROVIDER=omni         # default provider for new Lab videos: omni | veo | fal | fal:<model> | fake (each video can pick its own)
# LAB_PLANNER=openai              # storyboard planner: openai | fake
# LAB_IMAGE_PROVIDER=openai       # keyframe images: openai | fake
OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_SIZE=1024x1536     # generated portrait size, cropped to 9:16 → 1080x1920
# OPENAI_IMAGE_QUALITY=low        # low | medium | high (≈ 20 / 40 / 100 s per image)
# OPENAI_IMAGE_INPUT_FIDELITY=high  # gpt-image-1 only: how closely each keyframe follows the previous one

# ---------- app defaults (rarely changed) ----------
# DEFAULT_PERSONA=indie_maker     # fallback persona for the CLI and legacy imports (personas live in the DB; configs/personas/*.json are seeds)
# DATABASE_URL=postgresql+psycopg://ttcf:ttcf@db:5432/ttcf   # Docker default; use sqlite:///./clipfactory.db for a bare-metal run
# STORAGE_DIR=./storage           # renders, voices, plans, thumbnails, temp
# ASSETS_DIR=./assets             # your B-roll (assets/<persona>/<category>/)
# CONFIGS_DIR=./configs           # templates, caption styles, persona seeds
# FONTS_DIR=./fonts               # caption fonts (.ttf/.otf) offered in the UI and passed to libass
# FONT_FILE=                      # force one font file for captions (overrides the UI choice); normally empty
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# RENDER_THREADS=0                # 0 = ffmpeg default
# LOG_LEVEL=INFO
